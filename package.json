{
  "name": "intern-bps",
  "version": "1.0.0",
  "description": "InternBPS - Personal Daily Activity & Internship Tracker for BPS Interns",
  "main": "server/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node server/index.cjs",
    "client": "vite",
    "build": "vite build",
    "build:exe": "powershell -ExecutionPolicy Bypass -File ./scripts/build-exe.ps1",
    "build:portable": "powershell -ExecutionPolicy Bypass -File ./scripts/build-portable-zip.ps1",
    "preview": "vite preview"
  },
  "keywords": [
    "bps",
    "internship",
    "tracker",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  }
}
